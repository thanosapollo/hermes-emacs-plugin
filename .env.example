EMACS_EXEC_HOST=127.0.0.1
EMACS_EXEC_PORT=8237
EMACS_EXEC_TIMEOUT=30
# EMACS_EXEC_URL=
# Tool-name prefix. Default "emacs" yields emacs_ping, emacs_execute_code, etc.
# Set empty to drop the prefix when the agent already names the server.
# EMACS_MCP_TOOL_PREFIX=emacs
# Raw eval tool name. Defaults to <prefix>_execute_code.
# EMACS_EXEC_TOOL_NAME=emacs_execute_code
# Shared bearer token. REQUIRED whenever the Emacs host is not loopback
# (for example, a private-network address): the bridge refuses to start without it. Must
# match `hermes-exec-token' (or EMACS_EXEC_TOKEN) on the Emacs side.
# EMACS_EXEC_TOKEN=
# Optional comma-separated allowlist enabling emacs_call_interactive:
# EMACS_ALLOWED_COMMANDS=org-capture,org-agenda
